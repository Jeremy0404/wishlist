# Server-side .env for deploy/docker-compose.prod.yml on the "mediaserver"
# VPS. Copy to deploy/.env and fill in real values — never commit deploy/.env.

# --- Release ---------------------------------------------------------------

# Image tag to deploy, e.g. a git tag or release-please version. Both images
# (ghcr.io/jeremy0404/wishlist-web and -api) are published under this tag.
RELEASE_VERSION=

# Loopback port the web container is published on. Nginx Proxy Manager does
# not use this port — it reaches wishlist-web-1:80 by container name over the
# stack's private Docker network (see deploy/README.md); this port is only for
# host-local health checks (rollback.sh) and debugging.
APP_PORT=3005

# --- PostgreSQL ------------------------------------------------------------

POSTGRES_DB=wishlist
POSTGRES_USER=wishlist
# Must be URL-safe: it is interpolated into DATABASE_URL, where an unencoded
# "/" ends the host section and silently sends the API to 127.0.0.1 instead.
# Generate with `openssl rand -hex 32`, not `openssl rand -base64`.
POSTGRES_PASSWORD=

# --- Application -----------------------------------------------------------

# Signing secret for auth tokens. Rotating it invalidates every session.
JWT_SECRET=

# Public origin the emailed magic link points at. Must match the real
# hostname or the links in sent mail will 404.
APP_URL=https://wishlist.jerco.fr

# Transactional relay for the magic link. Left empty, the message is written
# to the log instead of being sent — which silently breaks sign-in for anyone
# not already holding a session.
SMTP_URL=
# Quoted because rollback.sh, backup.sh and backup-freshness-check.sh all
# `source` this file, and an unquoted "<" is a shell redirect.
MAIL_FROM="Wishlist <wishlist@jerco.fr>"

# --- Backups ---------------------------------------------------------------

# age public key (recipient) used to encrypt backup dumps. The matching
# private key is stored outside this repo and is the only way to decrypt them.
BACKUP_AGE_RECIPIENT=

# Off-host destination for encrypted backups. Deliberately blank: wishlist
# runs local-only backups for now, and backup.sh warns on every run until a
# real destination is set. Tracked as a follow-up issue.
BACKUP_OFFHOST_DESTINATION=

# Discord webhook used by deploy/backup-freshness-check.sh to alert when the
# latest backup is stale. Blank = no alerting. Tracked as a follow-up issue.
BACKUP_ALERT_DISCORD_WEBHOOK=

# Alert if the newest backup file is older than this many hours.
BACKUP_MAX_AGE_HOURS=26
