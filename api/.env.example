PORT=3000
DATABASE_URL=postgres://wishlist:wishlist@127.0.0.1:65432/wishlist
JWT_SECRET=change-me
UPLOADS_DIR=./uploads

# Origin the emailed magic link points at.
APP_URL=http://localhost:5173

# Transactional relay for the magic link, any provider that speaks SMTP.
# Left empty, the message is written to the log instead of being sent.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Wishlist <wishlist@jerco.fr>

# Auth throttling, in memory and per process — counters reset on restart.
# Requests per client IP on /auth/login, /auth/register and /auth/magic-link.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Magic links per email address, on top of the per-IP limit. Over this limit the
# endpoint still answers 200 and simply sends no mail.
MAGIC_LINK_RATE_LIMIT_MAX=3
MAGIC_LINK_RATE_LIMIT_WINDOW_MS=900000
